[sub_resource type="Shader" id="Shader_sv36c"]
code = "
shader_type spatial;
render_mode blend_mix,depth_draw_never,cull_back;
void fragment(){
 float f=pow(1.0-clamp(dot(normalize(NORMAL),normalize(VIEW)),0.,1.),5.);
 ALBEDO=vec3(.27,.30,.29);METALLIC=0.;ROUGHNESS=.12;SPECULAR=.5;ALPHA=.10+.50*f;
}
"

