[sub_resource type="Shader" id="Shader_d6y3f"]
code = "
shader_type spatial;
float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
void fragment(){
 float brushed=h(floor(UV*vec2(140.,1900.)));
 ALBEDO=vec3(.075,.085,.08)*(0.95+.1*brushed);
 METALLIC=.72;ROUGHNESS=.42+.13*brushed;SPECULAR=.38;
}
"

