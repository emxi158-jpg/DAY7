code = "
shader_type spatial;
render_mode cull_disabled;
void fragment(){vec2 q=(UV-.5)*2.;float r=length(q);float m=smoothstep(1.,.35,r);float rub=.5+.5*sin(UV.y*113.+sin(UV.x*19.));ALBEDO=vec3(.16,.19,.17);ROUGHNESS=.43;METALLIC=.08;ALPHA=m*(.11+rub*.035);}
"

