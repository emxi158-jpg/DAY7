[sub_resource type="Shader" id="Shader_3c1d4"]
code = "
shader_type spatial;
uniform sampler2D color_map: source_color,filter_linear_mipmap_anisotropic,repeat_enable;
uniform sampler2D normal_map: hint_normal,filter_linear_mipmap_anisotropic,repeat_enable;
void fragment(){
 vec3 grain=texture(color_map,UV*2.4).rgb;
 ALBEDO=mix(vec3(.19,.115,.057),grain,.48);
 NORMAL_MAP=texture(normal_map,UV*2.4).rgb;NORMAL_MAP_DEPTH=.24;
 ROUGHNESS=.92;SPECULAR=.15;
}
"

